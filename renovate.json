{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>aquaproj/aqua-renovate-config#2.12.1"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "postUpgradeTasks": {
    "commands": [
      "bash .github/scripts/update-aqua-checksum.bash"
    ],
    "fileFilters": [
      "aqua-checksums.json"
    ],
    "executionMode": "branch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "renovate.yml で固定している Renovate 本体のバージョンを更新する",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": ["renovate-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "renovatebot/renovate",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["aqua.yaml"],
      "groupName": "aqua packages"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 5,
  "rebaseWhen": "conflicted",
  "assignees": [],
  "reviewers": [],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore:",
  "semanticCommits": "enabled"
}
