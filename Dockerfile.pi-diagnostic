FROM ubuntu:26.04
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG PI_CODING_AGENT_VERSION=0.80.6
ENV DEBIAN_FRONTEND=noninteractive \
    VOLTA_HOME=/opt/volta \
    PATH="/opt/volta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://get.volta.sh | bash -s -- --skip-setup && \
    mkdir -p "$VOLTA_HOME" && \
    volta install node@v24.2.0 && \
    npm_config_ignore_scripts=true volta install \
      "@earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}" && \
    command -v pi && \
    pi --version
